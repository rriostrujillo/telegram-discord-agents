# Copia a .env y completa tus tokens — nunca commitees .env
# Telegram: https://t.me/BotFather → /newbot → copia token
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=  # tu Telegram user ID (ej: 8994867)

# Discord: https://discord.com/developers/applications → Bot → Reset Token
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=   # tu Discord user ID
DISCORD_ALLOWED_ROLES=
DISCORD_ALLOWED_CHANNELS=

# CLI backend por bot (opencode | claudecode | kilocode | custom)
# Se autodetecta con `which`/`where` — cámbialo por bot en la GUI
AI_BACKEND=opencode
AI_MODEL=opencode-zen/big-pickle

# Puerto del GUI + API (tu 8899)
PORT=8899
